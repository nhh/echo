# EditorConfig: https://editorconfig.org
# Gilt fuer das ganze Repository. Rust-Code formatiert rustfmt; diese Datei
# sorgt dafuer, dass Editoren schon beim Tippen dasselbe tun.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.rs]
# Wie rustfmt (max_width).
max_line_length = 100

[*.{toml,yml,yaml,json}]
indent_size = 2

[*.md]
# Zwei Leerzeichen am Zeilenende sind in Markdown ein Umbruch.
trim_trailing_whitespace = false

[*.cs]
# Nur tools/gen-csharp-fixtures.cs; Stil wie im C#-Vorgaenger.
indent_size = 4

[*.{sqlar,sqlar-wal,sqlar-shm}]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
